{
  "manifest_version": 3,
  "name": "Agent Board Tabs",
  "version": "1.0",
  "description": "Lets your local Agent Board find and switch to your Chrome tabs. Talks only to 127.0.0.1 on this computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "identity",
    "identity.email",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
